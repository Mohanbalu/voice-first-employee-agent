# ================================================================
# Voice-First Agentic AI Employee Workplace Assistant
# Environment Configuration Template
# ================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# NEVER hard-code credentials in source files.
# ================================================================

# ── Server ────────────────────────────────────────────────────
PROJECT_NAME="Voice-First Agentic AI Employee Workplace Assistant"
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# ── Security & Authentication ─────────────────────────────────
SECRET_KEY=replace_with_a_secure_random_secret_key_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Database — AWS RDS PostgreSQL + pgvector ──────────────────
# Use the psycopg (v3) sync driver for SQLAlchemy/Alembic.
# For asyncpg (async FastAPI), Module 4+ will add an async engine.
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@your-rds-instance.xyz.region.rds.amazonaws.com:5432/workplace_assistant

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_SSL_MODE=require

# pgvector embedding dimension — matches the active embedding model:
#   BAAI/bge-small-en-v1.5  → 384 (Local Sentence-Transformers, Primary)
#   text-embedding-3-small  → 1536 (OpenAI, Fallback)
VECTOR_DIMENSION=384

# Individual PG params (optional; DATABASE_URL takes priority if set)
POSTGRES_SERVER=your-rds-instance.xyz.region.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=DB_USER
POSTGRES_PASSWORD=DB_PASSWORD
POSTGRES_DB=workplace_assistant

# ── Multi-tenant Defaults (development/seed only) ─────────────
DEV_TENANT_ID=00000000-0000-0000-0000-000000000001
DEV_TENANT_NAME=Development Organization
DEV_TENANT_SLUG=dev-org

# ── AI Provider Configuration (Groq / Puter AI / OpenAI) ──────
# Primary provider: 'groq' (recommended), 'puter', or 'openai'
AI_PROVIDER=groq

# Groq AI Settings (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_placeholder
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Puter AI Settings (https://puter.com/dashboard)
PUTER_AUTH_TOKEN=your_puter_auth_token_placeholder
PUTER_MODEL=gpt-4o-mini
PUTER_BASE_URL=https://api.puter.com/puterai/openai/v1/

# ── Embeddings Configuration (Local Sentence-Transformers / BGE) ─────────
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT_SECONDS=60

# ── LLM & Embeddings (OpenAI Fallback) ─────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_placeholder
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=60

# ── Voice Processing (Module 6.1: Speech-to-Text) ─────────────
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en
STT_MAX_UPLOAD_SIZE_MB=25
STT_TIMEOUT_SECONDS=60

# ── Voice Processing (Module 6.3: Text-to-Speech) ─────────────
TTS_PROVIDER=groq
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=autumn
TTS_FORMAT=wav
TTS_SPEED=1.0
TTS_MAX_TEXT_LENGTH=5000
TTS_TIMEOUT_SECONDS=60

# ── Email & Notification Services (SMTP) ──────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=hr-support@company.com
SMTP_PASSWORD=your_smtp_password_placeholder
SMTP_TLS=True

# ── Integrations (Calendar, Ticketing, Navigation) ────────────
CALENDAR_API_KEY=your_calendar_api_key_placeholder
TICKET_SYSTEM_API_KEY=your_ticketing_api_key_placeholder
